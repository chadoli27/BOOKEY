// Copy this file to env.dart and fill in your Supabase project's values.
// env.dart is gitignored — never commit real credentials.
const supabaseUrl = 'YOUR_SUPABASE_URL';
const supabasePublishableKey = 'YOUR_SUPABASE_PUBLISHABLE_KEY';

const _storageBase = '$supabaseUrl/storage/v1/object/public';

/// bookCoverPath: "covers/charlottes-web.jpg" -> public Storage URL.
/// Pass-through if already a full URL (teacher pasted an external image link).
String bookCoverStorageUrl(String coverPath) {
  final trimmed = coverPath.trim();
  final uri = Uri.tryParse(trimmed);
  if (uri != null && uri.hasScheme) {
    return trimmed;
  }
  final withoutLeadingSlash = trimmed.startsWith('/')
      ? trimmed.substring(1)
      : trimmed;
  return '$_storageBase/$withoutLeadingSlash';
}
